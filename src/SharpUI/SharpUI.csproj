<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Veldrid.SDL2" Version="4.9.0" />
    <!-- 钉版压制 Veldrid.SDL2→NativeLibraryLoader→9.0.1 (GHSA-5crp-9r3c-p9vr) NU1903;M3e 移除 Veldrid.SDL2 后可删 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- D3 T4:SkiaSharp/SkiaSharp.HarfBuzz 已随 TextAtlas 重写移除(文本层全自研 FT/HB) -->
  </ItemGroup>

  <!-- D3 文本层:native/freetype + native/harfbuzz(来源/sha256 见 native/VERSIONS.md)。
       None+CopyToOutputDirectory 经 ProjectReference 传递到消费方输出(测试宿主/示例)根目录,
       P/Invoke 默认解析即可命中;VendorNativeText 再补 OutDir/Publish 的 runtimes/win-x64/native 布局。 -->
  <ItemGroup>
    <None Include="..\..\native\freetype\win-x64\freetype.dll" Link="freetype.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="freetype.dll" Visible="false" />
    <None Include="..\..\native\harfbuzz\win-x64\harfbuzz.dll" Link="harfbuzz.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="harfbuzz.dll" Visible="false" />
  </ItemGroup>

  <!-- 模式抄 examples/Counter/Counter.csproj 的 VendorModernSdl2:Build/Publish 后复制到 OutDir 根+runtimes/win-x64/native -->
  <Target Name="VendorNativeText" AfterTargets="Build;Publish" Condition="'$(VendorNativeText)' != 'false'">
    <ItemGroup>
      <VendoredText Include="..\..\native\freetype\win-x64\freetype.dll" />
      <VendoredText Include="..\..\native\harfbuzz\win-x64\harfbuzz.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VendoredText)" DestinationFiles="@(VendoredText->'$(OutDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VendoredText)" DestinationFiles="@(VendoredText->'$(OutDir)runtimes\win-x64\native\%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('$(OutDir)runtimes\win-x64\native\')" />
    <Copy SourceFiles="@(VendoredText)" DestinationFiles="@(VendoredText->'$(PublishDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(VendoredText)" DestinationFiles="@(VendoredText->'$(PublishDir)runtimes\win-x64\native\%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)runtimes\win-x64\native\')" />
  </Target>
</Project>
