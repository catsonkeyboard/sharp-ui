<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpUI.Tests" />
  </ItemGroup>

  <!-- 原生库 vendoring(D3 文本层 + T3 窗口层;来源/sha256 见 native/VERSIONS.md):
       freetype/harfbuzz + SDL2(2.30.8)。SDL2 原随旧窗口封装包以 runtimes 资产进输出,该包 T3 移除后
       本 vendoring 即唯一来源(IME 候选窗需 2.0.18+ 的 SDL_HINT_IME_SHOW_UI,见 SdlTextInput)。
       None+CopyToOutputDirectory 经 ProjectReference 传递到消费方输出(测试宿主/示例)根目录,
       P/Invoke 默认解析(SdlNative 候选序首项=基目录)即可命中;VendorNative 再补 OutDir/Publish 的
       runtimes/win-x64/native 布局。 -->
  <ItemGroup>
    <None Include="..\..\native\freetype\win-x64\freetype.dll" Link="freetype.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="freetype.dll" Visible="false" />
    <None Include="..\..\native\harfbuzz\win-x64\harfbuzz.dll" Link="harfbuzz.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="harfbuzz.dll" Visible="false" />
    <None Include="..\..\native\SDL2\win-x64\SDL2.dll" Link="SDL2.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="SDL2.dll" Visible="false" />
  </ItemGroup>

  <Target Name="VendorNative" AfterTargets="Build;Publish" Condition="'$(VendorNative)' != 'false'">
    <ItemGroup>
      <VendoredNative Include="..\..\native\freetype\win-x64\freetype.dll" />
      <VendoredNative Include="..\..\native\harfbuzz\win-x64\harfbuzz.dll" />
      <VendoredNative Include="..\..\native\SDL2\win-x64\SDL2.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VendoredNative)" DestinationFiles="@(VendoredNative->'$(OutDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VendoredNative)" DestinationFiles="@(VendoredNative->'$(OutDir)runtimes\win-x64\native\%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('$(OutDir)runtimes\win-x64\native\')" />
    <Copy SourceFiles="@(VendoredNative)" DestinationFiles="@(VendoredNative->'$(PublishDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(VendoredNative)" DestinationFiles="@(VendoredNative->'$(PublishDir)runtimes\win-x64\native\%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)runtimes\win-x64\native\')" />
  </Target>
</Project>
